# ─────────────────────────────────────────────────────────────
# AI YouTube Company — environment variables
# Copy to .env (gitignored) and fill in. NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────

# --- Mode ---------------------------------------------------------------
# true = everything offline (Mock LLM + Mock YouTube). Overrides LLM_PROVIDER / YOUTUBE_PROVIDER.
MOCK_MODE=true

# --- Channel ------------------------------------------------------------
CHANNEL_NICHE=暮らしに役立つ科学と雑学
CHANNEL_LANGUAGE=ja
YOUTUBE_REGION_CODE=JP
# comma-separated keywords the Researcher searches (max 3 used per run; search.list costs 100 quota units each)
RESEARCH_KEYWORDS=雑学,ライフハック,科学

# --- LLM (swap providers/models without code changes) ------------------
# mock | anthropic | openai
LLM_PROVIDER=mock
# e.g. claude-sonnet-5-5 (anthropic) or the model name of your OpenAI-compatible endpoint
LLM_MODEL=mock-model
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_MS=120000
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7

# --- YouTube ------------------------------------------------------------
# mock | youtube
YOUTUBE_PROVIDER=mock
# Public data (Research): API key from Google Cloud Console
YOUTUBE_API_KEY=
# OAuth (Upload + Analytics): OAuth client (Desktop/Web) from Google Cloud Console
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://127.0.0.1:53682/oauth2callback
# token written by `npm run youtube:auth` (gitignored)
YOUTUBE_TOKEN_PATH=./token.json
# Real uploads happen ONLY if this is true (and the video was approved)
YOUTUBE_UPLOAD_ENABLED=false
# public visibility requires explicit opt-in; otherwise uploads are forced to private
YOUTUBE_ALLOW_PUBLIC=false
YOUTUBE_DEFAULT_PRIVACY=private
# 27 = Education
YOUTUBE_CATEGORY_ID=27
# self-imposed daily cap on Data API quota units (Google default quota: 10,000/day)
YOUTUBE_DAILY_QUOTA_UNITS=5000
YOUTUBE_MIN_REQUEST_INTERVAL_MS=1000
# wait this long after publishing before analytics (mock default 0)
ANALYTICS_DELAY_HOURS=48

# --- Pipeline safety ------------------------------------------------------
# false = a human must approve every video before publishing
AUTO_PUBLISH=false
DAILY_VIDEO_LIMIT=3
MAX_RETRIES=3
MAX_SCRIPT_REVISIONS=2
AGENT_TIMEOUT_MINUTES=30
HEARTBEAT_INTERVAL_SECONDS=60
HEARTBEAT_MISS_TOLERANCE=3
WATCHDOG_INTERVAL_SECONDS=60
SUPERVISOR_INTERVAL_SECONDS=30
WORKER_POLL_INTERVAL_MS=2000
RETRY_BASE_DELAY_MS=5000
# true = after a pipeline completes, start the next one automatically (still capped by DAILY_VIDEO_LIMIT)
AUTO_CONTINUE=false
SHORTS_MIN_DURATION_SEC=10
SHORTS_MAX_DURATION_SEC=60
EXPERIMENT_MIN_SAMPLES=3

# --- Storage / logs -------------------------------------------------------
DATA_DIR=./data
# sqlite:<path>. (PostgreSQL adapter can be added behind the same SqlDatabase interface)
DATABASE_URL=sqlite:./data/company.db
LOG_DIR=./logs
LOG_LEVEL=INFO
LOG_TO_FILE=true

# --- Dashboard ------------------------------------------------------------
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=3100
# required for approve/goal actions if the dashboard is exposed beyond localhost
DASHBOARD_TOKEN=

# --- Notifications --------------------------------------------------------
# comma-separated: console, discord, slack, none
NOTIFY_CHANNELS=console
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
