# ===== AI Note Company =====
# mock: LLM / note / analytics をすべてシミュレーション（APIキー・noteログイン不要）
# live: 実際のLLMとPlaywright(note.com)を使う
RUN_MODE=mock

# ----- LLM -----
# mock | anthropic | openai
LLM_PROVIDER=mock
LLM_MODEL=
# APIキーは .env にのみ記載（Gitには入れない）
LLM_API_KEY=

# ----- note -----
NOTE_AUTO_PUBLISH=false
BROWSER_HEADLESS=false
NOTE_BASE_URL=https://note.com
# Playwright storageState 保存先（Git管理外）
NOTE_STORAGE_STATE=./.auth/note-storage.json
# 人間ログイン待機の最大時間（分）
NOTE_LOGIN_TIMEOUT_MINUTES=10

# ----- 運用 -----
DAILY_ARTICLE_LIMIT=1
DEFAULT_ARTICLE_MODE=FREE
DEFAULT_ARTICLE_PRICE=980
QUALITY_THRESHOLD=80
MAX_REVISIONS=2

# ----- Watchdog -----
HEARTBEAT_INTERVAL_SECONDS=60
AGENT_TIMEOUT_MINUTES=30
MAX_RETRIES=3
SUPERVISOR_TICK_SECONDS=60

# ----- スケジュール（HH:MM, ローカル時刻）-----
# immediate にすると時刻を待たずに順次実行
SCHEDULE_MODE=daily
SCHEDULE_RESEARCH=08:00
SCHEDULE_STRATEGY=09:00
SCHEDULE_WRITING=10:00
SCHEDULE_QUALITY=11:00
SCHEDULE_DRAFT=11:30
# 公開から何時間後にAnalyticsを走らせるか
ANALYTICS_DELAY_HOURS=24

# ----- 通知 -----
# console | discord | slack
NOTIFICATION_PROVIDER=console
NOTIFICATION_WEBHOOK_URL=

# ----- 画像 -----
# placeholder | openai
IMAGE_PROVIDER=placeholder
IMAGE_API_KEY=

# ----- リサーチ（任意）-----
# YouTube Data API v3（未設定ならYouTubeトレンドはスキップ）
YOUTUBE_API_KEY=
# 公開RSS（Googleトレンド / ニュース）を取得するか
RESEARCH_FETCH_RSS=true
# note.com のトップ等をブラウザで閲覧してテーマ傾向を読むか（本文はコピーしない）
RESEARCH_NOTE_BROWSE=false

# ----- Dashboard -----
DASHBOARD_PORT=3939
DASHBOARD_HOST=127.0.0.1

# ----- パス -----
DATABASE_PATH=./data/ai-note-company.db
DATA_DIR=./data
LOG_DIR=./logs
